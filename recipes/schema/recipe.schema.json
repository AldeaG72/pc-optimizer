{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AldeaG72/pc-optimizer/blob/main/recipes/schema/recipe.schema.json",
  "title": "Recipe",
  "description": "O rețetă = un tweak documentat și reversibil.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "category", "risk", "profiles", "impact", "why", "breaks", "requires_restart", "platform", "sources", "verified", "actions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/i18n" },
    "description": { "$ref": "#/$defs/i18n" },
    "category": { "enum": ["windows", "gaming", "power", "input", "network", "audio", "debloat", "privacy", "cleanup", "gpu-nvidia", "gpu-amd", "services", "advanced"] },
    "risk": { "enum": ["safe", "moderate", "advanced"] },
    "profiles": { "type": "array", "items": { "enum": ["recommended", "laptop"] }, "uniqueItems": true },
    "impact": { "$ref": "#/$defs/i18n" },
    "why": { "$ref": "#/$defs/i18n" },
    "breaks": { "$ref": "#/$defs/i18n" },
    "requires_restart": { "enum": ["none", "explorer", "signout", "reboot"] },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_build"],
      "properties": {
        "min_build": { "type": "integer", "minimum": 22000 },
        "max_build": { "type": "integer" },
        "editions": { "type": "array", "items": { "enum": ["home", "pro", "enterprise", "education"] } },
        "form_factor": { "enum": ["any", "desktop", "laptop"], "default": "any" }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "verified": { "type": "boolean", "description": "false până când cheile au fost verificate în documentație și testate în CI" },
    "actions": { "type": "array", "minItems": 1, "items": { "oneOf": [ { "$ref": "#/$defs/registry" }, { "$ref": "#/$defs/service" }, { "$ref": "#/$defs/power-plan" }, { "$ref": "#/$defs/power-setting" }, { "$ref": "#/$defs/net-adapter" }, { "$ref": "#/$defs/appx" }, { "$ref": "#/$defs/cleanup" } ] } }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ro", "en"],
      "properties": { "ro": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "hive", "key", "value"],
      "properties": {
        "type": { "const": "registry" },
        "hive": { "enum": ["HKCU", "HKLM"] },
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["dword", "qword", "string"] },
        "set": { "type": ["integer", "string"] },
        "delete": { "const": true },
        "only_if": {
          "type": ["integer", "string"],
          "description": "Aplică doar dacă valoarea actuală e aceasta (de ex. cea implicită Windows); altfel rețeta „nu se aplică”."
        }
      },
      "oneOf": [
        { "required": ["kind", "set"], "not": { "required": ["delete"] } },
        { "required": ["delete"], "not": { "anyOf": [ { "required": ["set"] }, { "required": ["kind"] }, { "required": ["only_if"] } ] } }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "startup"],
      "properties": {
        "type": { "const": "service" },
        "name": { "type": "string", "minLength": 1 },
        "startup": { "enum": ["automatic", "manual", "disabled"] }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^\\{?[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\}?$"
    },
    "power-plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Activează un plan de alimentare existent (GUID-ul planului).",
      "required": ["type", "scheme"],
      "properties": {
        "type": { "const": "power-plan" },
        "scheme": { "$ref": "#/$defs/guid" }
      }
    },
    "power-setting": {
      "type": "object",
      "additionalProperties": false,
      "description": "O setare a planului activ: valoarea pe priză (ac) și/sau pe baterie (dc).",
      "required": ["type", "subgroup", "setting"],
      "anyOf": [ { "required": ["ac"] }, { "required": ["dc"] } ],
      "properties": {
        "type": { "const": "power-setting" },
        "subgroup": { "$ref": "#/$defs/guid" },
        "setting": { "$ref": "#/$defs/guid" },
        "ac": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "dc": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "net-adapter": {
      "type": "object",
      "additionalProperties": false,
      "description": "O valoare din cheia de driver a fiecărei plăci de rețea fizice.",
      "required": ["type", "value", "kind", "set"],
      "properties": {
        "type": { "const": "net-adapter" },
        "value": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" },
        "kind": { "enum": ["dword", "qword", "string"] },
        "set": { "type": ["integer", "string"] },
        "advertised": { "type": "boolean", "description": "Doar plăcile al căror driver oferă setarea (implicit true)." }
      }
    },
    "appx": {
      "type": "object",
      "additionalProperties": false,
      "description": "Elimină o aplicație preinstalată pentru utilizatorul curent; undo o reinstalează.",
      "required": ["type", "package"],
      "properties": {
        "type": { "const": "appx" },
        "package": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,99}$" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "description": "Șterge fișiere dintr-un loc fix. Nu se poate anula.",
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "cleanup" },
        "target": { "enum": ["user-temp", "windows-temp", "update-cache", "launcher-caches", "recycle-bin"] }
      }
    }
  }
}
